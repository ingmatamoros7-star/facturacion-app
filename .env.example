# Copia este archivo como .env (o configura estas variables en tu hosting)

# Puerto del servidor (por defecto 3000)
PORT=3000

# Entorno: en "production" las cookies se marcan como seguras (HTTPS)
NODE_ENV=production

# Secreto para firmar la sesión (JWT). CÁMBIALO por un valor largo y aleatorio.
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# Carpeta del disco persistente donde se guarda la base de datos SQLite.
# En Render suele ser /opt/render/project/data (ver render.yaml).
# Si no se define, la base se crea junto al proyecto (facturacion.db).
DB_PATH=/opt/render/project/data

# Credenciales del primer usuario administrador (solo se usan al crear la BD).
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123
