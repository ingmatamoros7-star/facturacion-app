# Copia este archivo como .env (o configura estas variables en tu hosting)

# Puerto del servidor (por defecto 3000)
PORT=3000

# Entorno: en "production" las cookies se marcan como seguras (HTTPS)
NODE_ENV=production

# Secreto para firmar la sesión (JWT). CÁMBIALO por un valor largo y aleatorio.
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# --- Base de datos ---
# En producción usa Turso (libSQL). Crea una base gratis en https://turso.tech
# y pega aquí su URL y token:
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# Si NO defines las variables TURSO_*, el sistema usa un archivo SQLite local
# (facturacion.db). DB_PATH indica la carpeta donde guardarlo (opcional).
# DB_PATH=/ruta/a/carpeta/persistente

# Credenciales del primer usuario administrador (solo al crear la BD).
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123
